# Copy to .env. Never commit real secrets.
DATABASE_URL=postgresql+psycopg://fieldops:fieldops@db:5432/fieldops
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-before-any-shared-deployment
DEMO_MODE=true
DEMO_AUTH_ENABLED=true
MODEL_MODE=fixture
TOKEN_TTL_MINUTES=480
INVESTIGATIONS_PER_MINUTE=5
RUN_STEP_DELAY_MS=300
CORS_ORIGINS=http://localhost:5173
APPROVAL_EXPIRY_MINUTES=30
RETRIEVAL_TOP_K=4
MAX_RETRIES=2
LOG_LEVEL=INFO
